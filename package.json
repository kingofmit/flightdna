{
  "name": "flightdna",
  "version": "0.0.0",
  "private": true,
  "description": "Open framework for aircraft digital twins — real-time performance monitoring, predictive maintenance, and fleet analytics using public ADS-B data.",
  "author": "Ahmed Allem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/flightdna.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish",
    "docs": "typedoc",
    "validate": "tsx scripts/validate.ts",
    "validate:real": "tsx scripts/validate-real.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "tsx": "^4.0.0",
    "turbo": "^2.4.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.73.0"
  }
}
