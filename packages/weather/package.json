{
  "name": "@flightdna/weather",
  "version": "0.1.0",
  "description": "NOAA weather client and atmospheric model for FlightDNA — METAR, TAF, ISA calculator, wind and density at altitude.",
  "license": "MIT",
  "author": "Ahmed Allem",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@flightdna/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/flightdna.git",
    "directory": "packages/weather"
  },
  "keywords": [
    "flightdna",
    "weather",
    "noaa",
    "metar",
    "taf",
    "atmosphere",
    "isa",
    "aviation",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
