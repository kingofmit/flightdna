{
  "name": "@flightdna/adsb",
  "version": "0.3.1",
  "description": "ADS-B message decoder and OpenSky Network API client for FlightDNA.",
  "license": "MIT",
  "author": "Ahmed Allem",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@flightdna/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/flightdna.git",
    "directory": "packages/adsb"
  },
  "keywords": [
    "flightdna",
    "adsb",
    "ads-b",
    "mode-s",
    "opensky",
    "aircraft-tracking",
    "aviation",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
